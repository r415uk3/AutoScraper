TELEGRAM_BOT_TOKEN=your_token_here

# Optional, defaults shown
# REFRESH_INTERVAL=35          # seconds between page checks
# RETRY_DELAY=30               # first restart delay after a failure, grows each time
# MAX_RETRY_DELAY=300          # cap for the restart delay
# LOGIN_MAX_ATTEMPTS=3
# ALERT_REPEAT_INTERVAL=3600   # repeat the same Telegram alert at most this often
# ACTIVE_DAYS=1-6              # 1 = Monday ... 7 = Sunday; empty = every day
# ACTIVE_HOURS=07:30-21:30     # empty = around the clock
# BROWSER_CHANNEL=             # empty = bundled Chromium; chrome = installed Google Chrome
